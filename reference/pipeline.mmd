flowchart TB
  classDef src fill:#F0D9C9,stroke:#B35A28,stroke-width:1.5px,color:#3a2208;
  classDef pub fill:#D1F1F1,stroke:#0B6E6E,stroke-width:1.5px,color:#053333;
  classDef rev fill:#E9E5DC,stroke:#5E5A50,stroke-width:1.5px,color:#2c2a24;
  classDef store fill:#ffffff,stroke:#5E5A50,stroke-width:1.3px,color:#2c2a24;

  raw@{ shape: doc, label: "Raw source" }
  asset@{ shape: docs, label: "Immutable Asset(s)" }
  record@{ shape: doc, label: "Ordered Selection / Record" }
  ingester@{ shape: rounded, label: "Ingester" }
  ingest@{ shape: doc, label: "Ingest" }
  housekeeping@{ shape: rounded, label: "Scheduler housekeeping" }
  housekeeping_proposals@{ shape: docs, label: "Housekeeping proposals" }
  predigest@{ shape: doc, label: "Pre-digest" }
  archive@{ shape: docs, label: "records/ archive" }
  bucket@{ shape: lin-cyl, label: "Object storage" }
  workbench@{ shape: rounded, label: "Workbench" }
  digester@{ shape: rounded, label: "Digester" }
  digests@{ shape: docs, label: "Per-model digests (planned)" }
  selector@{ shape: rounded, label: "Digest selector (planned)" }
  selected@{ shape: doc, label: "Canonical digest" }
  assimilator@{ shape: rounded, label: "Assimilator" }
  kg@{ shape: cyl, label: "Knowledge graph" }
  synthesiser@{ shape: rounded, label: "Synthesiser" }
  briefs@{ shape: doc, label: "Brief" }
  assembler@{ shape: rounded, label: "Assembler" }
  content@{ shape: doc, label: "Content" }
  site@{ shape: rounded, label: "Site" }
  brand@{ shape: docs, label: "Brand" }

  raw -->|"acquire exact bytes"| ingester
  ingester -->|"archive by byte SHA-256"| asset
  asset -->|"ordered whole/page selectors"| record
  record -->|"generate current representation"| ingest
  ingester -.->|"post-commit fast path"| housekeeping
  ingest -->|"startup + ≤5-minute tuple reconciliation"| housekeeping
  housekeeping -->|"deterministic, then priority subscription research"| housekeeping_proposals
  housekeeping_proposals <-.->|"gate review; decide + atomic apply"| workbench
  asset -->|"originals"| archive
  ingester -->|"raw transcripts"| archive
  archive -->|"originals uploaded off-machine"| bucket
  bucket -.->|"public Assets only"| site
  bucket -.->|"gated Assets, per-member authority"| workbench
  ingest -->|"deterministic prep: exact input + PDF/image source map"| predigest
  predigest -->|"exact model input + bound source map"| digester
  digester ==>|"current: one canonical, every claim quote-checked"| selected
  digester -.->|"planned: 1..N candidates"| digests
  digests -.->|"planned candidates"| selector
  selector -.->|"planned: picks one"| selected
  selected ==>|"one per record (1:1)"| assimilator
  assimilator <-->|"reads + updates; shortlists duplicate nodes for review"| kg
  kg -->|"entity + its claims"| synthesiser
  synthesiser ==>|"a brief per page (one -> many)"| briefs
  briefs -->|"the page's brief (1:1)"| assembler
  selected -->|"one record (1:1)"| assembler
  ingest -.->|"current review + per-Asset rights"| assembler
  assembler -->|"entity articles + stable Record pages"| content
  content -->|"renders"| site
  brand -.->|"tokens, logo"| site
  ingest <-.->|"review + corrections"| workbench
  record <-.->|"target: CAS split/compose + atomic retirement"| workbench
  predigest -.->|"validate existing parent source maps"| workbench
  selector <-.->|"planned: review the selection"| workbench
  assimilator <-.->|"merge shortlist + replayable graph curation"| workbench
  archive -.->|"check against source"| workbench
  workbench -.->|"review verdict + Ingest annotations"| digester

  class raw,asset,record,ingest,housekeeping_proposals,predigest,archive,bucket src
  class ingester,housekeeping,digester,digests,selector,selected,assimilator,kg,synthesiser,briefs,assembler,content,site pub
  class workbench rev
  class brand store

  click raw nodeClick
  click asset nodeClick
  click record nodeClick
  click ingester nodeClick
  click ingest nodeClick
  click housekeeping nodeClick
  click housekeeping_proposals nodeClick
  click predigest nodeClick
  click archive nodeClick
  click bucket nodeClick
  click workbench nodeClick
  click digester nodeClick
  click digests nodeClick
  click selector nodeClick
  click selected nodeClick
  click assimilator nodeClick
  click kg nodeClick
  click synthesiser nodeClick
  click briefs nodeClick
  click assembler nodeClick
  click content nodeClick
  click site nodeClick
  click brand nodeClick
